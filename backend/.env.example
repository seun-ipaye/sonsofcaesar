# Copy to .env (git-ignored) for local development.
# On Railway, set these in the service's Variables tab instead.

DATABASE_URL=postgresql+psycopg://localhost/sonsofcaesar_dev

# Stripe SANDBOX keys only while building (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend API key (re_...)
RESEND_API_KEY=
EMAIL_FROM=Sons of Caesar <tickets@sonsofcaesar.xyz>

# Where the website lives (used for links in emails and Stripe redirects)
SITE_URL=http://localhost:5173

# Websites allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Where this API is reachable (QR image links in emails)
API_URL=http://localhost:8000

# Private R2 bucket for database backups (NOT the public gallery bucket).
# Only needed where backups run (the Railway "backup" service).
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=sonsofcaesar-backups
